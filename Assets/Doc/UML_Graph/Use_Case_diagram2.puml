@startuml use case
left to right direction
skinparam packageStyle rectangle
actor "Developer/Simulation System" as dev

package "GPU Compute Helpers Module" {
    usecase "Manage GPU Buffers & Textures" as UC1
    usecase "Dispatch Compute Shaders" as UC2
    usecase "Calculate Spatial Hash" as UC3
    usecase "Perform GPU Sort\n(Count/Radix)" as UC4
    usecase "Calculate Parallel Prefix Sum\n(Scan)" as UC5
    usecase "Calculate Spatial Offsets" as UC6
}

dev --> UC1
dev --> UC2
dev --> UC3
dev --> UC4

UC3 ..> UC4 : <<include>>
UC3 ..> UC6 : <<include>>
UC4 ..> UC5 : <<include>>

@enduml