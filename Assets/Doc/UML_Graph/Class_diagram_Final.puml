@startuml class
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60

' --- Level 2: Core Static Helper ---
class ComputeHelper <<static>> {
    + defaultFilterMode: FilterMode
    + defaultGraphicsFormat: GraphicsFormat
    - argsBufferArray: uint[]
    - singleInstanceRenderArgs: uint[]
    + Dispatch()
    + CalculateThreadGroupCount1D()
    + CreateStructuredBuffer()
    + CreateRenderTexture()
    + SetBuffer()
    + LoadComputeShader()
    + ReadbackData()
    + Release()
}

' --- Level 3: Intermediate Utilities ---
class Scan {
    - cs: ComputeShader
    - freeBuffers: Dictionary
    + Run()
    + Release()
}

class SHOCRadix {
    - cs: ComputeShader
    + Run()
}

' --- Level 4: Core Calculators ---
class GPURadixSort {
    - scan: Scan
    - cs: ComputeShader
    - sortedIndexBuffer: ComputeBuffer
    - sortedKeyBuffer: ComputeBuffer
    + Run()
    + Release()
}

class SpatialOffsetCalculator {
    - cs: ComputeShader
    + Run()
}

class GPUCountSort {
    - scan: Scan
    - cs: ComputeShader
    - sortedItemsBuffer: ComputeBuffer
    - countsBuffer: ComputeBuffer
    + Run()
    + Release()
}

' --- Level 5: High-level Application Classes ---
class SHRadix {
    + SpatialKeys: ComputeBuffer
    + SpatialIndices: ComputeBuffer
    + SpatialOffsets: ComputeBuffer
    - gpuSort: GPURadixSort
    - spatialOffsetsCalc: SpatialOffsetCalculator
    + Resize()
    + Run()
    + Release()
    - CreateBuffers()
}

class SpatialHash {
    + SpatialKeys: ComputeBuffer
    + SpatialIndices: ComputeBuffer
    + SpatialOffsets: ComputeBuffer
    - gpuSort: GPUCountSort
    - spatialOffsetsCalc: SpatialOffsetCalculator
    + Resize()
    + Run()
    + Release()
    - CreateBuffers()
}

' --- Dependencies ---
Scan -up-> ComputeHelper
SHOCRadix -up-> ComputeHelper
GPURadixSort -up-> ComputeHelper
GPURadixSort -up-> Scan
SpatialOffsetCalculator -up-> ComputeHelper
GPUCountSort -up-> ComputeHelper
GPUCountSort -up-> Scan
SHRadix -up-> GPURadixSort
SHRadix -up-> SpatialOffsetCalculator
SHRadix -up-> ComputeHelper
SpatialHash -up-> GPUCountSort
SpatialHash -up-> SpatialOffsetCalculator
SpatialHash -up-> ComputeHelper

@enduml