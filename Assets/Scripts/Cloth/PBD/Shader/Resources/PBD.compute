#pragma kernel InitPara
#pragma kernel ApplyAndPredicate
#pragma kernel ProjectConstraints 
#pragma kernel UpdateProperty

RWStructuredBuffer<float4> positions;
RWStructuredBuffer<float3> velocities;
RWStructuredBuffer<float4> normals;
RWStructuredBuffer<float4> prePos;

// x表示横向质点数量，y表示纵向质点数量,z = x * y
uint4 size;
float3 springKs;
uniform float3 restLengths;
uniform float mass;

#define Cd 0.5
float4 viscousFluidArgs;
#define Uf viscousFluidArgs.xyz
#define Cv viscousFluidArgs.w

float deltaTime;
#define dt deltaTime
#define totalParticleCount size.z
#define L0 restLengths.x
#define M mass

uniform float4 collisionBall;

// 【修复】改为 int2 处理负方向
static int2 SpringDirs[12] = 
{
    {1,0}, {0,1}, {-1,0}, {0,-1},          // 结构力
    {-1,-1}, {-1,1}, {1,-1}, {1,1},        // 剪力
    {-2,0}, {2,0}, {0,2}, {0,-2}           // 弯矩力
};

static uint getIndex(uint2 id){
    return id.y * size.x + id.x;
}

static float3 getPosition(uint index){ return positions[index].xyz; }
static float3 getPredicatePosition(uint index){ return prePos[index].xyz; }
static float3 getPosition(uint2 id){ return positions[getIndex(id)].xyz; }
static float3 getVelocity(uint index){ return velocities[index]; }
static float3 getNormal(uint index){ return normals[index].xyz; }

// 【修复】引入公用的布料固定点判断
static bool isPinned(uint2 id){
    return id.y == 0 && (id.x == 0 || id.x == size.x - 1);
}

// 【修复】严格安全的边界判断
static bool isValidateId(int2 id){
    return id.x >= 0 && id.x < (int)size.x && id.y >= 0 && id.y < (int)size.y;
}

static float3 calcExForce(uint2 id)
{
    uint index = getIndex(id);
    float3 currVel = getVelocity(index);
    float3 f = float3(0,0,0);
    // damping
    f += -Cd * currVel;
    // gravity
    f += float3(0, -9.8, 0) * M;
    // wind
    float3 normal = getNormal(index);
    f += Cv * (dot(normal, Uf - currVel)) * normal;
    return f;
}

static int2 normalCompuDirs[4] = { {1,0}, {0,1}, {-1,0}, {0,-1} };

static void updateNormal(uint2 id)
{
    float3 p = getPosition(id);
    float3 normal = float3(0,0,0);
    for(uint i = 0; i < 4; i ++)
    {
        uint j = (i + 1) % 4;
        // 【修复】转换为 int2 进行安全的坐标偏移
        int2 id1 = (int2)id + normalCompuDirs[i];
        int2 id2 = (int2)id + normalCompuDirs[j];
        if(isValidateId(id1) && isValidateId(id2))
        {
            float3 p1 = getPosition((uint2)id1);
            float3 p2 = getPosition((uint2)id2);
            float3 e1 = p1 - p;
            float3 e2 = p2 - p;
            normal += normalize(cross(e1,e2));
            break;
        }
    }
    normals[getIndex(id)] = float4(normalize(normal),0);
}

// collision constrain on prePos
static void solveCollision(uint index)
{
    float3 pos = prePos[index].xyz;
    float3 bCenter = collisionBall.xyz;
    float bRadius = collisionBall.w;
    float disToBall = distance(pos, bCenter) - bRadius;
    if(disToBall < 0)
    {
        float3 e = normalize(pos - bCenter);
        prePos[index] = float4(pos - disToBall * e, prePos[index].w);
    }
}

#define THREAD_X 8
#define THREAD_Y 8

[numthreads(THREAD_X,THREAD_Y,1)]
void InitPara(uint3 id:  SV_DispatchThreadID)
{   
    uint index = getIndex(id.xy);
    // [fix] when init, w must be 1，and init prePos to avoid frame 1 = NaN
    positions[index] = float4(id.x * L0, 0, id.y * L0, 1.0);
    prePos[index] = positions[index];
    velocities[index] = float3(0,0,0);
    normals[index] = float4(0,1,0,0);
}

[numthreads(THREAD_X,THREAD_Y,1)]
void ApplyAndPredicate(uint3 id:  SV_DispatchThreadID)
{
    if(isPinned(id.xy)) return; // 【修复】不预测固定点
    
    uint index = getIndex(id.xy);
    float3 f = calcExForce(id.xy);
    float3 a = f * rcp(M);
    float3 velocity = getVelocity(index) + a * dt;
    velocities[index] = velocity;
    updateNormal(id.xy);
    
    prePos[index] = positions[index] + float4(velocities[index] * deltaTime, 0);
}

[numthreads(THREAD_X,THREAD_Y,1)]
void ProjectConstraints(uint3 id:  SV_DispatchThreadID)
{
    if(isPinned(id.xy)) return;     // [fix] no constrain on pin
    
    uint index = getIndex(id.xy);
    float3 currPos = getPredicatePosition(index);
    float3 deltaPos = float3(0,0,0);
    uint validCount = 0;    // [fix] take valid constrain counter
    
    for(uint i = 0; i < 12; i ++)
    {
        int2 nId = (int2)id.xy + SpringDirs[i];
        if(isValidateId(nId))
        {
            uint nIndex = getIndex((uint2)nId);
            float3 nPos = getPredicatePosition(nIndex);
            float3 curr2Neighbor = normalize(nPos - currPos);
            float springLength = distance(nPos, currPos);
            float d = restLengths[i/4]; 
            
            deltaPos += 0.5 * (springLength - d) * curr2Neighbor; 
            validCount++;
        }
    }
    
    // [fix] clamp the delta pos to avoid explore, 1.5 is SOR 超松弛因子加速收敛
    if(validCount > 0)
    {
        prePos[index] += float4(deltaPos / (float)validCount, 0) * 1.5; 
    }

    solveCollision(index);
}

[numthreads(THREAD_X,THREAD_Y,1)]
void UpdateProperty(uint3 id:  SV_DispatchThreadID)
{
    if(isPinned(id.xy)) return;
    
    uint index = getIndex(id.xy);
    velocities[index] = (prePos[index].xyz - positions[index].xyz) / deltaTime;
    // [fix] w === 1.0
    positions[index] = float4(prePos[index].xyz, 1.0); 
}